{
  "cli": { "version": ">= 18.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "image": "latest" }
    },
    "simulator": { "extends": "development", "ios": { "simulator": true, "image": "latest" } },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "environment": "production",
      "ios": { "image": "latest" }
    }
  },
  "submit": { "production": {} }
}
