{
  "expo": {
    "name": "Pocket Budget",
    "slug": "pocket-budget",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mingonsong.pocketbudget",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "Connect to your local Pocket backend while testing on your Wi-Fi network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#233C32",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mingonsong.pocketbudget"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      ["expo-secure-store", { "configureAndroidBackup": false }],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Photograph a receipt to review and add it to your budget.",
          "photosPermission": "Choose a receipt image to review and add it to your budget.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      [
        "llama.rn",
        { "enableEntitlements": false, "forceCxx20": true, "enableOpenCLAndHexagon": false }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a", "x86_64"],
            "extraProguardRules": "-keep class com.rnllama.** { *; }"
          }
        }
      ],
      "./plugins/with-local-ai"
    ],
    "scheme": "pocketbudget",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "165287c3-0bf6-4bc7-9772-d80583c9df04"
      }
    },
    "owner": "mgsong19"
  }
}
