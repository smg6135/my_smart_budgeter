{
  "expo": {
    "name": "Pocket Budget",
    "slug": "pocket-budget",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mingonsong.pocketbudget",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "Connect to your local Pocket backend while testing on your Wi-Fi network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#233C32",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mingonsong.pocketbudget"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Photograph a receipt to review and add it to your budget.",
          "photosPermission": "Choose a receipt image to review and add it to your budget.",
          "microphonePermission": false
        }
      ],
      "expo-font"
    ],
    "scheme": "pocketbudget"
  }
}
