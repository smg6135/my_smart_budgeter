# Local emulators. Public Firebase configuration is not a provider secret.
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-pocket
EXPO_PUBLIC_FIREBASE_API_KEY=fake-emulator-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-pocket.firebaseapp.com
EXPO_PUBLIC_AUTH_EMULATOR_URL=http://localhost:9099

# Production: remove AUTH_EMULATOR_URL; use terraform output firebase_public_config.
# EXPO_PUBLIC_API_US_URL=https://backend.normiesai.com
# EXPO_PUBLIC_API_SG_URL=https://sg.backend.normiesai.com
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=web-client-id.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=ios-client-id.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.ios-client-id
